<!DOCTYPE html>
<html lang="hu">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <link rel="stylesheet" href="/css/building/buildings.css" />
        <title>Épületek</title>
    </head>
    <body>
		<%- include('../nav.ejs') %>
		<div id="buildings-container">
			<% buildings.forEach(building => { %>
                <div class="building-container">
                    <h1><%= building.nev %></h1>
                    <img src="<%= building.kep %>" alt="<%= building.nev %>" />
                    <p><%= building.leiras %></p>
                    <div class="building-gombs">
                        <button onclick="torol('<%= building._id %>')">Töröl</button>
                        <a href="/api/buildings/<%= building._id %>">Lekér módosításra</a>
                    </div>
                </div>
			<% }) %>
		</div>
        <script src="/js/building/building-torol.js"></script>
	</body>
</html>
