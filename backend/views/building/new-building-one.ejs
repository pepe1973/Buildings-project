<!DOCTYPE html>
<html lang="hu">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <link
            rel="stylesheet"
            href="/css/building/new-building.css"
        />
        <title>Új épület felvétele</title>
    </head>
    <body>
        <%- include('../nav.ejs') %>
        <div id="new-building-container">
            <h1>Új épület felvétele</h1>
            <form>
                <table>
                    <tr>
                        <td><label for="nev">Név:</label></td>
                        <td>
                            <input
                                type="text"
                                id="nev"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td><label for="leiras">Leírás:</label></td>
                        <td>
                            <textarea
                                id="leiras"
                                rows="10"
                                cols="30"
                            ></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td><label for="kep">Kép:</label></td>
                        <td>
                            <input
                                type="text"
                                id="kep"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td><button id="feltolt">Feltölt</button></td>
                        <td></td>
                    </tr>
                </table>
            </form>
        </div>
        <script src="/js/building/building-feltolt.js"></script>
    </body>
</html>
